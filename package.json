{
  "name": "alberdi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fee-aware complete-set arbitrage engine for Polymarket CLOB V2 with OpenAI supervision.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts run",
    "scan": "tsx src/index.ts scan",
    "paper": "tsx src/index.ts paper",
    "live": "tsx src/index.ts live",
    "doctor": "tsx src/index.ts doctor",
    "report": "tsx src/index.ts report",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js run",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@polymarket/clob-client-v2": "1.0.8",
    "commander": "^14.0.1",
    "dotenv": "^17.2.2",
    "openai": "^6.46.0",
    "pino": "^9.9.4",
    "prom-client": "^15.1.3",
    "viem": "^2.55.0",
    "ws": "^8.21.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "eslint": "9.35.0",
    "tsx": "^4.20.5",
    "typescript": "5.8.3",
    "typescript-eslint": "8.41.0",
    "vitest": "3.2.4"
  },
  "overrides": {
    "ws": "^8.21.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
