# Alberdi configuration template
# Copy to .env, keep permissions at 0600, and never commit real secrets.

# scanner | paper | live
MODE=scanner
NODE_ENV=production
LOG_LEVEL=info

# Capital objective. The target is observational and never weakens risk limits.
STARTING_CAPITAL_USD=10
TARGET_CAPITAL_USD=100
TARGET_DEADLINE_HOURS=168
STOP_AT_TARGET=true

# Market discovery and book freshness
MAX_MARKETS=80
DISCOVERY_REFRESH_MS=300000
EVALUATION_INTERVAL_MS=750
BOOK_STALE_MS=10000
REST_SEED_CONCURRENCY=5

# All thresholds are NET of taker fees, executable depth and safety reserve.
MIN_NET_EDGE_BPS=80
MIN_EXPECTED_PROFIT_USD=0.01
MAX_CAPITAL_PER_TRADE_USD=6
MAX_MARKET_EXPOSURE_USD=7
MAX_OPEN_EXPOSURE_USD=7
MAX_UNHEDGED_USD=0.50
MAX_DAILY_LOSS_USD=1
MAX_CONSECUTIVE_FAILURES=3
SAFETY_RESERVE_BPS=25
OPPORTUNITY_COOLDOWN_MS=15000

# Local observability and durable audit data
HTTP_PORT=8787
DATA_DIR=./data

# Polymarket and Polygon endpoints. Override only for an intentional environment change.
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_GEO_URL=https://polymarket.com/api/geoblock
POLYGON_RPC_URL=https://polygon-rpc.com

# Live mode: dedicated EOA only. Never use a wallet containing unrelated assets.
PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_BUILDER_CODE=
LIVE_TRADING_ACK=

# Optional relayer credentials supported by the runtime configuration.
RELAYER_URL=https://relayer-v2.polymarket.com
RELAYER_API_KEY=
RELAYER_API_SECRET=
RELAYER_API_PASSPHRASE=

# OpenAI is a supervisory control plane, never the latency-critical order executor.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_SUPERVISION_INTERVAL_MS=1800000
